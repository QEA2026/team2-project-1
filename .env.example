# Shared AWS RDS for PostgreSQL connection settings
RDSHOST=
RDS_PORT=
RDS_DB_NAME=
RDS_USERNAME=
RDS_PASSWORD=

# AWS RDS connections should use TLS. Set verify-full and configure the AWS CA
# certificate in production when your deployment environment supports it.
RDS_SSLMODE=require
RDS_CONNECT_TIMEOUT=10

# Employee app only: schema/seed initialization is opt-in and should normally be
# run once during deployment, not by every application instance.
DB_INIT_ON_STARTUP=false
DB_SEED_ON_STARTUP=false
