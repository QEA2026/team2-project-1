FROM maven:3.9.11-eclipse-temurin-21 AS build

WORKDIR /build

# Cache dependency downloads separately from application source changes.
COPY pom.xml ./
RUN mvn -B dependency:go-offline

COPY src ./src
# This image only needs the production artifact. Unlike -DskipTests, this also
# skips test compilation, so stale or integration-only test sources do not
# prevent the runtime image from being built.
RUN mvn -B -Dmaven.test.skip=true package dependency:copy-dependencies \
    -DincludeScope=runtime \
    -DoutputDirectory=target/dependency

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

RUN addgroup -S app && adduser -S app -G app

COPY --from=build /build/target/manager_app-1.0-SNAPSHOT.jar app.jar
COPY --from=build /build/target/dependency ./lib

USER app

EXPOSE 7000

ENTRYPOINT ["java", "-cp", "app.jar:lib/*", "com.revature.Main"]
